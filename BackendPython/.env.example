# ============================================================
# Backend Configuration - Copy to .env and fill in values
# ============================================================

# === 🔑 OPENAI API - REQUIRED ===
# Get key from: https://platform.openai.com/api/keys
# 1. Go to the link above
# 2. Click "Create new secret key"
# 3. Copy the key (sk-proj-...)
# 4. Paste below
OPENAI_API_KEY=sk-proj-your-api-key-here

# === Database Configuration ===
# Docker PostgreSQL connection
# Note: Uses port 15432 (docker-compose mapping from 5432)
DATABASE_URL=postgresql://admin:your_password@localhost:15432/product_db
REDIS_URL=redis://localhost:6379

# === Authentication ===
# JWT secret key for token signing
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-secret-key-change-in-production

# === Crawler Configuration ===
ENABLE_LAZADA_CRAWLER=true
ENABLE_TIKI_CRAWLER=true

# === Feature Flags ===
# Enable product caching (makes refinements 100x faster)
ENABLE_PRODUCT_CACHING=true

# Enable LLM fallback for dynamic intent detection
ENABLE_LLM_INTENT_FALLBACK=true

# === Logging ===
LOG_LEVEL=INFO
